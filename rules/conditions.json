    "聲量不過大": { "none": ["R08"], "penalty": -2.0, "explain": "聲量太大的組織，企業可能只是借品牌" },
    "樂意配合": { "any": ["R13"], "bonus": 1.0, "explain": "課後追蹤有回應" },
    "組織穩定": { "any": ["R12"], "none": ["R06", "R07"], "bonus": 1.5, "explain": "穩定型，且沒有主管換人或計畫過多" },
    "願意嘗試新做法": { "any": ["R11"], "bonus": 2.0, "explain": "主動問新工具、想試新做法" },
    "需要關心": { "any": ["R02", "R03", "R04", "R06", "R10", "R16"], "bonus": 1.5, "explain": "有動盪或久未接觸的訊號" },
    "想跟沒跟上": { "any": ["R18"], "bonus": 1.5, "explain": "第二、三波：想做但還沒跟上（Q10）" }
  },
  "recent_partner_penalty": -3.0,
  "scenario_defaults": {
    "實驗課": { "multiplier": 3, "soft": ["願意嘗試新做法", "有動機"] },
    "例行課": { "multiplier": 3, "soft": ["組織穩定", "樂意配合", "想跟沒跟上"] },
    "企業陪跑": { "multiplier": 5, "_出處": "Q6 企業選 10 家，聯盟約給 50 家評估名單", "soft": ["樂意配合", "有動機"] },
    "年度走訪": { "multiplier": 2, "soft": ["需要關心"] }
  },
  "demand_templates": [
    { "match": ["實驗", "試辦", "先導", "新課", "測試"], "scenario": "實驗課", "soft": ["願意嘗試新做法"] },
    { "match": ["走訪", "健檢", "關懷", "訪視", "年度"], "scenario": "年度走訪", "soft": ["需要關心"] },
    { "match": ["陪跑", "企業", "CSR", "專業志工"], "scenario": "企業陪跑", "soft": ["樂意配合", "有動機"] },
    { "match": ["公關", "行銷", "品牌", "媒體", "社群"], "soft": ["有基本行銷能力", "聲量不過大"] },
    { "match": ["財務", "財報", "會計", "桑基", "核銷"], "soft": ["有財務需求"] },
    { "match": ["反霸凌", "職場", "人資", "勞動"], "hard": { "全職人數": { "min": 5 } } },
    { "match": ["課程", "培力", "工作坊"], "scenario": "例行課" }
  ],
  "feedback_reasons": {
