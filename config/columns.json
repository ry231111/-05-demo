{
  "_說明": "資料源切換與欄位對應。當天換真資料只改這個檔：source 改成 official、files 改檔名、columns 的候選欄名補上真欄名、value_maps 補值的寫法。columns 每個標準欄位給一串候選欄名，依序找第一個存在的。",
  "source": "mock",
  "sources": {
    "mock": {
      "dir": "data/mock",
      "files": { "orgs": "organizations.csv", "contacts": "contacts.csv", "notes": "consultant_notes.csv" }
    },
    "drill": {
      "dir": "data/drill",
      "files": { "orgs": "好事大平台_假資料 - 組織主檔.csv", "contacts": "好事大平台_假資料 - 接觸紀錄.csv", "notes": "好事大平台_假資料 - 顧問筆記.csv" }
    },
    "official": {
      "dir": "data/official",
      "files": { "orgs": "組織主檔.csv", "contacts": "接觸紀錄.csv", "notes": "顧問筆記.csv" }
    }
  },
  "ref_date": "auto",
  "date_formats": ["%Y-%m-%d", "%Y/%m/%d", "%Y.%m.%d", "%Y-%m-%d %H:%M:%S", "%Y/%m/%d %H:%M", "ROC"],
  "tables": {
    "orgs": {
      "columns": {
        "id": ["組織編號", "組織代碼", "編號", "統編"],
        "name": ["名稱", "組織名稱", "組織"],
        "議題": ["議題", "服務議題", "主要議題"],
        "服務對象": ["服務對象", "服務族群"],
        "區域": ["區域", "地區", "所在區域"],
        "縣市": ["所在縣市", "縣市", "所在地"],
        "會籍": ["會籍", "會員狀態", "會員身分", "會員資格"],
        "全職人數": ["全職人數", "專職人數", "全職員工數"],
        "財報類型": ["財報類型", "財務報表類型"],
        "桑基圖上架": ["桑基圖上架", "桑基圖", "是否上架桑基圖", "桑基圖是否上架"],
        "陪跑分級": ["陪跑分級", "陪跑等級"],
        "年度收入區間": ["年度收入區間", "年收入", "營業額"]
      },
      "assumed": ["name", "年度收入區間"]
    },
    "contacts": {
      "columns": {
        "record_id": ["紀錄編號", "編號", "ID"],
        "org_id": ["組織編號", "組織代碼", "統編"],
        "date": ["日期", "接觸日期", "活動日期"],
        "type": ["接觸類型", "類型"],
        "activity": ["活動名稱", "活動", "課程名稱"],
        "title": ["參與者職稱", "職稱"],
        "text": ["留下的話", "備註", "回饋", "內容"],
        "source": ["資料來源", "來源"]
      },
      "assumed": ["record_id"],
      "id_prefix": "C"
    },
    "notes": {
      "columns": {
        "note_id": ["筆記編號", "編號"],
        "org_id": ["組織編號", "組織代碼", "統編"],
        "date": ["日期", "記錄日期"],
        "author": ["記錄者", "顧問", "撰寫者"],
        "occasion": ["場合"],
        "text": ["筆記內容", "顧問筆記", "內容", "筆記"]
      },
      "assumed": ["note_id", "author", "occasion"],
      "id_prefix": "N"
    }
  },
  "value_maps": {
    "會籍": { "正式會員": "會員", "一般會員": "會員", "準會員": "準會員", "非會員": "非會員" },
    "桑基圖上架": { "是": true, "Y": true, "y": true, "已上架": true, "有": true, "TRUE": true, "否": false, "N": false, "n": false, "未上架": false, "無": false, "FALSE": false },
    "縣市別名": { "臺": "台", "台北": "台北市", "北市": "台北市", "新北": "新北市", "台中": "台中市", "中市": "台中市", "台南": "台南市", "高雄": "高雄市", "桃園": "桃園市" },
    "縣市→區域": {
      "北部": ["台北市", "新北市", "基隆市", "桃園市", "新竹市", "新竹縣", "宜蘭縣"],
      "中部": ["苗栗縣", "台中市", "彰化縣", "南投縣", "雲林縣"],
      "南部": ["嘉義市", "嘉義縣", "台南市", "高雄市", "屏東縣"],
      "東部": ["花蓮縣", "台東縣"],
      "離島": ["澎湖縣", "金門縣", "連江縣"]
    },
    "資料來源": { "ragic": "Ragic", "Ragic系統": "Ragic", "RAGIC": "Ragic", "sharepoint": "SharePoint", "Google 表單": "Google表單", "google表單": "Google表單", "Line": "LINE", "line": "LINE", "email": "Email", "E-mail": "Email", "信件": "Email" },
    "接觸類型": { "課程": "培力課程", "培力": "培力課程", "追蹤": "課後追蹤", "訪視": "走訪", "實地走訪": "走訪", "大會": "會員大會", "危機處理": "危機諮詢", "入選": "獎補助入選", "補助入選": "獎補助入選" }
  }
}
